# DBShield Environment Configuration Template
# Copy to .env for local overrides (never commit real credentials)

# HTTP Client Settings
DBSHIELD_HTTP_TIMEOUT=10.0
DBSHIELD_MAX_REDIRECTS=5
DBSHIELD_USER_AGENT="DBShield/0.1.0 (Database Vulnerability Assessment Framework)"

# Logging Settings (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DBSHIELD_LOG_LEVEL=INFO
# DBSHIELD_LOG_FILE=/path/to/dbshield.log

# Scope Management (JSON array or comma-separated list of authorized hosts)
DBSHIELD_ALLOWED_HOSTS='["example.com", "app.example.com"]'
DBSHIELD_ALLOW_SUBDOMAINS=false

# Rate Limiting (Requests per second)
DBSHIELD_RATE_LIMIT=10.0
